              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mass assignment protection: role is ignored.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker2\",\n  \"email\": \"hacker2@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('role is customer', () => pm.expect(pm.response.json().user.role).to.eql('customer'));"
                ]
              }
            }
          ]
        }
