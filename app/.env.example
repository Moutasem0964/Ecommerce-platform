APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_MAX_RETRIES=1
REDIS_TIMEOUT=1
CACHE_BREAKER_SECONDS=5

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS="orders@ecommerce.test"
MAIL_FROM_NAME="سوق التقنية"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DEMO ONLY: force a failure right after reserving stock (R2 compensation demo)
ORDERS_FAIL_AFTER_RESERVE=false

API_RATE_LIMIT=60

CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL=600
HTTP_ETAG_ENABLED=true
DB_READ_HOST=mysql-replica
READ_YOUR_WRITES_SECONDS=5
REPLICA_MAX_LAG_SECONDS=2

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/

# DEMO ONLY: force the email worker to fail every send (R4 DLQ demo)
ORDER_EMAIL_FAIL_SENDING=false
ORDER_EMAIL_RETRY_TTL_MS=10000
ORDER_EMAIL_MAX_ATTEMPTS=5

# Laravel Reverb (self-hosted WebSocket server, reached through nginx /app)
REVERB_APP_ID=ecommerce-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
